# =====================================================================================================================
# Copy to `.env` (cp .env.example .env). `.env` is git-ignored. Values below are DEV/DEMO-ONLY placeholders.
# The backend refuses to start with APP_ENV=production if it detects "dev-only"/"change-me" placeholders.
# Generate real secrets with:   openssl rand -base64 32      (SECRETS_ENCRYPTION_KEY must decode to exactly 32 bytes)
#                               openssl rand -hex 32         (SESSION_SECRET, DB password, HMAC secrets)
# =====================================================================================================================

# --- Database (PostgreSQL container; never published to the host in the demo stack) ---
POSTGRES_USER=ukt
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_DB=ukt

# --- Application ---
# development | demo | production.  `demo` = Docker demo: mock gateway ON, cookies not Secure (plain http://localhost).
APP_ENV=demo
SESSION_SECRET=dev-only-session-secret-change-before-real-use-0123456789
# 32 random bytes, base64. Encrypts institution HMAC secrets at rest (AES-256-GCM).
SECRETS_ENCRYPTION_KEY=ZGV2LW9ubHktZGVtby1rZXktMzItYnl0ZXMtbG9uZyE=
# true ONLY when served over HTTPS (production). http://localhost needs false.
COOKIE_SECURE=false
# Mock payment gateway (POST /api/dev/webhooks/simulate + "Gateway Simulator" page). MUST be false in production.
MOCK_GATEWAY_ENABLED=true
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
LOG_LEVEL=info

# --- Seed data (demo only) ---
SEED_DEMO_DATA=true
DEMO_PASSWORD=demosevima
# Optional: fix the per-institution HMAC secrets (otherwise random ones are generated; show them with `npm run secrets:show`).
# Share real secrets with the gateway out-of-band (e.g. email) -- never commit them.
HMAC_SECRET_UM001=
HMAC_SECRET_UB001=
HMAC_SECRET_UI001=

# --- Frontend ---
FRONTEND_PORT=8080
# Show demo accounts helper on the login page (demo only).
VITE_SHOW_DEMO_ACCOUNTS=true
